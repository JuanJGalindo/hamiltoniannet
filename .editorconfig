# EditorConfig — https://editorconfig.org
# Encodes the ruff style from pyproject.toml (line-length 100, spaces, double quotes).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
# ruff format: double quotes, 4-space indent, magic trailing comma respected
quote_type = double

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,toml,json}]
indent_size = 2

[Makefile]
indent_style = tab
